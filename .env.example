APP_NAME=MedStock Insight API
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://medstock:<local-password>@localhost:5432/medstock
POSTGRES_PASSWORD=
MEDSTOCK_DEMO_PASSWORD=
# Set a generated random secret; an omitted key is ephemeral for local use only.
# JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
